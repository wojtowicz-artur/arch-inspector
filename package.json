{
  "name": "arch-inspector",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A small, deterministic TypeScript architecture inspector.",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./cli": "./dist/src/cli.js"
  },
  "bin": {
    "arch": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "inspect": "npm run build && node dist/src/cli.js inspect",
    "check": "npm run build && node dist/src/cli.js check",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "format": "oxfmt src test scripts",
    "format:check": "oxfmt --check src test scripts",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint --fix src test scripts",
    "quality": "npm run format:check && npm run lint && npm test"
  },
  "dependencies": {
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0"
  }
}
